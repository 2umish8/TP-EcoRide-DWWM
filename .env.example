# EcoRide Docker Environment Variables
# Copy this file to .env and modify the values as needed

# === Application Configuration ===
COMPOSE_PROJECT_NAME=ecoride
NODE_ENV=production

# === Database Configuration ===
# MySQL
MYSQL_ROOT_PASSWORD=s8Qw3z!pLk2V
MYSQL_DATABASE=ecoride_db
MYSQL_USER=ecoride_user
MYSQL_PASSWORD=9vT!e2QpLx7R

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=7gX!p2QzLm9R
MONGO_INITDB_DATABASE=ecoride_db

# Redis
REDIS_PASSWORD=ecoride-redis-2025

# === Security Configuration ===
JWT_SECRET=ecoride-super-secret-jwt-key-2025-production
JWT_EXPIRATION=24h
BCRYPT_SALT_ROUNDS=12

# === Network Configuration ===
FRONTEND_PORT=80
BACKEND_PORT=3000
MYSQL_PORT=3306
MONGODB_PORT=27017
REDIS_PORT=6379

# Development tools ports
ADMINER_PORT=8080
MONGO_EXPRESS_PORT=8081

# === CORS Configuration ===
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://frontend

# === Development Mode ===
# Uncomment the following line to enable development tools
# COMPOSE_PROFILES=development