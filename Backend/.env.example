# =============================================================================
# BACKEND CONFIGURATION - Example File
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to Git (it's in .gitignore)

# Environment
NODE_ENV=development
PORT=3000

# Security
JWT_SECRET=your_super_long_random_jwt_secret_here
JWT_EXPIRATION=1h
BCRYPT_SALT_ROUNDS=10

# MySQL Database (Prisma)
# Development: mysql://ecoride_user:ecoride_password@localhost:3306/ecoride_db
# Production: Use Render/Railway environment variables
DATABASE_URL="mysql://username:password@localhost:3306/ecoride_db"

# MongoDB (for reviews and preferences)
# Development: mongodb://127.0.0.1:27017/ecoride_reviews (use 127.0.0.1 instead of localhost on Windows)
# Production: Use MongoDB Atlas (ask 2umish8 on GitHub for access)
MONGODB_URI=mongodb://127.0.0.1:27017/ecoride_reviews
