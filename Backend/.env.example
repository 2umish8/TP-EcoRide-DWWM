# Configuration de développement local
# Ceci est un fichier d'exemple. Copiez-le en `.env` et remplissez les valeurs appropriées.
# Ne le modifiez pas directement, car en cas de commit (il n'est pas dans .gitignore), vos informations sensibles seraient exposées.
# Ces valeurs sont évidemment fictives, remplacez-les par vos propres configurations.

DB_HOST=localhost
DB_USER=votre_utilisateur_mysql # souvent 'root' par défaut
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=ecoride_db # Nom de la base de données
PORT=3000

# Sécurité
JWT_SECRET=votre_secret_jwt_super_long_et_aleatoire
JWT_EXPIRATION=1h
BCRYPT_SALT_ROUNDS=10

# URL de l'API pour le frontend
VITE_API_URL=http://localhost:3000/api

# Configuration MongoDB
# Pour développement local : mongodb://localhost:27017/ecoride_reviews
# Pour production/Atlas : mongodb+srv://user:pass@cluster.mongodb.net/db
MONGODB_URI=mongodb://127.0.0.1:27017/ecoride_reviews # Ou au lieu de 127.0.0.1, localhost si ça marche pas.

# Configuration de l'environnement
NODE_ENV=development
