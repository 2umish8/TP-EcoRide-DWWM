# EcoRide Backend - Docker ignore file
# Exclude files and directories that shouldn't be copied to the container

# Dependencies
node_modules
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Logs
logs
*.log

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Environment variables
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# Development and build files
**/.git
**/.gitignore
**/.dockerignore
**/Dockerfile*
**/compose*.yaml
**/compose*.yml
README*.md

# IDE and editor files
**/.vscode
**/.idea
**/.vs
**/.settings
**/.project
**/.classpath
**/.toolstarget
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
**/*.dbmdl
**/*.*proj.user

# Test files and scripts
scripts/test*
scripts/run*
scripts/check*
__tests__
test/
*.test.js
*.spec.js

# Documentation
docs/
Documentation/

# Database files
*.sqlite
*.db

# Temporary files
tmp/
temp/
.cache
.next
**/*.jfm
**/charts
**/docker-compose*
**/compose.y*ml
**/Dockerfile*
**/node_modules
**/npm-debug.log
**/obj
**/secrets.dev.yaml
**/values.dev.yaml
**/build
**/dist
LICENSE
README.md
